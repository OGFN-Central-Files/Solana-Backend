# Solana Configuration
PORT=5353
MAINTENANCE=false
CONNECTION_URL=Host=localhost;Port=5432;Database=your_database;Username=your_username;Password=your_password;Pooling=true
JWTSECRET=your_jwt_secret_key_here

# Version 
CURRENT_VERSION=10
Current_QuestWeek=1

# Fortnite Configuration
MATCHMAKER=wss://your_matchmaker_url:port
MM_SESSION_SOCKET=ws://your_session_socket_host:port

# Cloudflare R2 Configuration
CF_REGION=your_region
CF_ACCESS_ID=your_access_id
CF_SECRET_KEY=your_secret_key
CF_ENDPOINT=https://your_endpoint.r2.cloudflarestorage.com

# Synapse Configuration
S_PASSWORD=your_synapse_password
S_BASEURL=http://your_synapse_url:port
S_APITOKEN=your_api_token